# Copy to .env and fill in. Only PLEX_TOKEN is required.

# How to find it: https://support.plex.tv/articles/204059436-finding-an-authentication-token-x-plex-token/
PLEX_TOKEN=

# Defaults to the Docker host (Plex on host networking). Use your server's LAN IP if that doesn't connect.
# PLEX_URL=http://192.168.1.10:32400

# Shows to switch on automatically, separated by semicolons (titles as they appear in Plex).
# You can also just toggle shows on the Admin page.
# AUTO_INDEX_SHOWS=Futurama;Invincible

# Protect the Admin page (username "admin") if the site is reachable by anyone else.
# ADMIN_PASSWORD=

# Public base URL for share-link previews (Discord etc.) when behind a reverse proxy.
# PUBLIC_URL=https://quotes.example.com

# Grab a thumbnail for every line while indexing (fast browsing, roughly 5-8 MB per episode)
# instead of rendering frames on demand and caching them.
# PREGENERATE_THUMBS=false

# Size cap for on-demand frames, memes and GIFs (least recently used are deleted first).
# CACHE_MAX_MB=2048

# CONFIG_DIR=/mnt/user/Docker/Quotarr
# MEDIA_DIR=/mnt/user/Media
